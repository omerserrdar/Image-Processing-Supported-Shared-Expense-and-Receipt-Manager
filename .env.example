# ReceiptShare v2 — Environment Variables
# Copy this file to .env and fill in your real values.

# --- Application ---
APP_PORT=8080
SECRET_KEY=generate-a-random-secret-key-here
DEFAULT_LANGUAGE=en

# --- Google Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/receiptshare?retryWrites=true&w=majority
MONGODB_DB_NAME=receiptshare
